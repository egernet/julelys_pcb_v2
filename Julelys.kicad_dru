(version 1)
# JLCPCB capabilities, 4-layer, 1 oz outer / 1 oz inner
# https://jlcpcb.com/capabilities/pcb-capabilities

(rule "JLC PTH hole to track"
	(condition "A.Type == 'Pad' && A.isPlated() && B.Type == 'Track'")
	(constraint hole_clearance (min 0.28mm)))

(rule "JLC NPTH hole to copper"
	(condition "A.Type == 'Pad' && !A.isPlated()")
	(constraint hole_clearance (min 0.2mm)))

(rule "JLC pad hole to pad hole"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC via hole to via hole"
	(condition "A.Type == 'Via' && B.Type == 'Via'")
	(constraint hole_to_hole (min 0.2mm)))

(rule "JLC SMD pad to pad"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B.Net")
	(constraint clearance (min 0.15mm)))

(rule "JLC silkscreen to pad"
	(layer outer)
	(condition "A.Type == 'Pad'")
	(constraint silk_clearance (min 0.15mm)))

# Decoupling caps / pull-ups may sit inside their IC's courtyard margin (bodies do not touch).
# R8/V_IN2: the terminal courtyard includes the 45-degree wire entry; R8 body is 1.3 mm clear.
(rule "Courtyard margin, cap at its IC"
	(severity ignore)
	(condition "(A.Reference == 'U1' && B.Reference == 'R36') || (A.Reference == 'U8' && B.Reference == 'C20') || (A.Reference == 'U9' && B.Reference == 'C21') || (A.Reference == 'U3' && B.Reference == 'C5') || (A.Reference == 'V_IN2' && B.Reference == 'R8')")
	(constraint courtyard_clearance (min 0mm)))
